FUNCTION suvt_a(u:REAL,v:REAL,t:REAL) RETURNS REAL
 RETURN (v-u)/t
ENDFUNCTION

CONSTANT u1<-5
CONSTANT v1<-10
CONSTANT t1<-1
OUTPUT suvt_a(u1,v1,t1+3)