//--------------------------------------------------------------------------
//                  字符串函数
//
// LEFT(ThisString : STRING, x : INTEGER) RETURNS STRING
// RIGHT(ThisString : STRING, x : INTEGER) RETURNS STRING
// MID(ThisString : STRING, x : INTEGER, y : INTEGER) RETURNS STRING
// LENGTH(ThisString : STRING) RETURNS INTEGER
// TO_UPPER(x : STRING|CHAR) RETURNS STRING|CHAR
// TO_LOWER(x : STRING|CHAR) RETURNS STRING|CHAR
// NUM_TO_STR(x : INTEGER|REAL) RETURNS INTEGER|REAL
// STR_TO_NUM(x : STRING) RETURNS INTEGER|REAL
// IS_NUM(ThisString : STRING|CHAR) RETURNS BOOLEAN
// ASC(ThisChar : CHAR) RETURNS INTEGER
// CHR(x : INTEGER) RETURNS CHAR
// ThisString1 & ThisString2    // 连接两个字符串
//
//--------------------------------------------------------------------------
DECLARE  str : STRING

OUTPUT "LEFT('abcdefg', 4)   =" , LEFT("abcdefg",4)      // "abcd"
OUTPUT "RIGHT('abcdefg', 4)  =" , RIGHT("abcdefg",4)     // "defg"
OUTPUT "MID('abcdefg', 2,4)  =" , MID("abcdefg",2,4)     // "bcde"
OUTPUT ""

OUTPUT "TO_UPPER('abcdefg')  =" , TO_UPPER("abcdefg")    // "ABCDEDFG"
OUTPUT "TO_UPPER('i')        =" , TO_UPPER("i")          // "I"
OUTPUT "TO_LOWER('ABCDEDFG') =" , TO_LOWER("ABCDEDFG")   // "abcdefg"
OUTPUT "TO_LOWER('I')        =" , TO_LOWER("I")          // "i"
OUTPUT ""

OUTPUT "NUM_TO_STR(123)      =" , NUM_TO_STR(123)        // "123"
OUTPUT "NUM_TO_STR(123.45)   =" , NUM_TO_STR(123.45)     // "123.45"
OUTPUT "STR_TO_NUM('123')    =" , STR_TO_NUM("123")      //  123
OUTPUT "STR_TO_NUM('123.45') =" , STR_TO_NUM("123.45")   //  123.45
OUTPUT ""

//OUTPUT "ASC('A')             =" , ASC('A')             // 
OUTPUT "CHR(50)              =" , CHR(50)                // '2'
OUTPUT "字符串函数" & "测试完毕"
OUTPUT ""

//--------------------------------------------------------------------------
//                           数值函数
//
//  INT(x : REAL) RETURNS INTEGER   //  将REAL转化为INTEGER
//  RAND(x : INTEGER) RETURNS REAL  //  x以内的随机数
//  MOD(num, 2)                     //  取模
//  DIV(num, 2)                     //  取商
//  ROUND(real,2)                   //  四舍五入2位小数
//
//--------------------------------------------------------------------------

OUTPUT "INT(50.1)              =" , INT(50.1)             // 50
OUTPUT "RAND(100)              =" , RAND(100)             // 
OUTPUT "MOD(100,7)             =" , MOD(100,7)            // 2
OUTPUT "DIV(100,7)             =" , DIV(100,7)            // 14
OUTPUT "ROUND(1/3.0,3)         =" , ROUND(2/3.0,3)        // 0.667
OUTPUT "数值函数" & "测试完毕"
OUTPUT ""

//--------------------------------------------------------------------------
//                           DATE 函数
//
// DAY(ThisDate : DATE) RETURNS INTEGER
// MONTH(ThisDate : DATE) RETURNS INTEGER
// YEAR(ThisDate : DATE) RETURNS INTEGER
// DAYINDEX(ThisDate : DATE) RETURNS INTEGER
// SETDATE(Day, Month, Year : INTEGER) RETURNS DATE
// TODAY() RETURNS DATE
//
//--------------------------------------------------------------------------

DECLARE today :DATE
today <- SETDATE(1,10,2024)
OUTPUT  "SETDATE(1,10,2024)     =", today
OUTPUT  "DAY(today)             =", DAY(today)
OUTPUT  "MONTH(today)           =", MONTH(today)
OUTPUT  "YEAR(today)            =", YEAR(today)
//OUTPUT  "DAYINDEX(today)        =", DAYINDEX(today)
OUTPUT "日期函数" & "测试完毕"
OUTPUT ""

//--------------------------------------------------------------------------
//                           FILE 函数
//
//  file mode: READ / WRITE / APPEND
//
//  OPENFILE    file_name FOR  file mode    以读或写模式打开文件
//  READFILE    file_name, string_var_name  从文件中读取一行到STRING
//  WRITEFILE   file_name, string_var_name  将STRING按行写入文件
//  EOF         file_name                   文件是否读到末尾
//  CLOSEFILE   file_name                   关闭打开的文件
//--------------------------------------------------------------------------

DECLARE oneLine : STRING

OPENFILE "SimonC/Syntax/in.txt" FOR READ
OPENFILE "SimonC/Syntax/out.txt" FOR WRITE

WHILE NOT EOF("SimonC/Syntax/in.txt")
    READFILE "SimonC/Syntax/in.txt", oneLine
    IF oneLine = "" THEN
        WRITEFILE "SimonC/Syntax/out.txt", "*blank line  " & "\n"
    ELSE
        WRITEFILE "SimonC/Syntax/out.txt", oneLine & "\n"
    ENDIF
ENDWHILE

CLOSEFILE "SimonC/Syntax/in.txt"
CLOSEFILE "SimonC/Syntax/out.txt"
OUTPUT "文件函数" & "测试完毕"
OUTPUT ""
