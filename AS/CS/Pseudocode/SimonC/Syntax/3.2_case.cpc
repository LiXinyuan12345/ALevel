DECLARE choice : INTEGER

INPUT choice
CASE  OF choice
1 :  OUTPUT "Word is starting...."
2 :  OUTPUT "Excel is starting...."
//3:   OUTPUT "PowerPoint is starting...."
//4:   OUTPUT "goodbye!"
//OTHERWISE
ENDCASE 

