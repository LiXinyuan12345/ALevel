//
//  简单条件判断语法
//
//  IF condition THEN
//        .....
//  ENDIF
//
//
//  IF condition THEN
//        .....
//  ELSE
//        ..... 
//  ENDIF
//



//
//  嵌套条件判断语法
//
//  IF condition1 THEN
//        IF condition2 THEN
//           .....
//        ELSE
//           ..... 
//        ENDIF
//        .....
//  ELSE
//        ..... 
//  ENDIF
//
// DECLARE  v : INTEGER

// INPUT v
// IF v <= 0 THEN
//     IF v = 0 THEN
//         OUTPUT "zero"
//     ELSE
//         OUTPUT "negative number"
//     ENDIF

// ELSE
//     OUTPUT v
// ENDIF
DECLARE i:INTEGER
OUTPUT "ENTER AN INTERGER:"
INPUT i
IF i<=0 THEN
    IF i=0 THEN
        OUTPUT "i equal to 0"
    ELSE
        OUTPUT "i is smaller than 0"
    ENDIF
ELSE
    OUTPUT "i is bigger than 0"
ENDIF


